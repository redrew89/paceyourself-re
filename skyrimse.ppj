<?xml version='1.0'?><!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output=".\data\scripts"
    Optimize="false"
    Release="false"
    Final="false">
    <Imports>
        <Import>.\data\source\scripts</Import>
        <Import>Z:\SteamLibrary\steamapps\common\Skyrim Special Edition\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>.\data\source\scripts</Folder>
    </Folders>
</PapyrusProject>